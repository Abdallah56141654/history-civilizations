# Public site URL (used for canonical, hreflang, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.github.io/history-civilizations
# Only for GitHub project pages (https://user.github.io/repo): the repo name with leading slash.
NEXT_PUBLIC_BASE_PATH=/history-civilizations

# Optional: map tile provider (default is the public OpenStreetMap server; see its tile usage policy for production traffic).
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; Your tile provider and OpenStreetMap contributors

# Map tiles (optional). Default: OpenStreetMap's public tile server, which is fine for development and
# low traffic only (https://operations.osmfoundation.org/policies/tiles/). For production use a tile provider
# (MapTiler, Stadia, Thunderforest, self-hosted) and set both values, keeping the provider's attribution.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Operator details shown on Privacy, Terms and Contact. Leave empty and the pages show a visible placeholder.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=

# Analytics (optional). With a GA4 id set, a consent banner appears and Google loads only after "Accept".
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=
# Ads (optional, reserved layout only; see src/components/AdSlot.tsx)
NEXT_PUBLIC_ADS_ENABLED=false
